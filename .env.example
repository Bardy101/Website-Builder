# Postal Outreach Pipeline — Phase 0 configuration
# Copy to `.env` and fill in. Never commit your real .env.

# Google Places API (New) key — used by the discover stage.
# https://developers.google.com/maps/documentation/places/web-service
GOOGLE_PLACES_API_KEY=

# Google PageSpeed Insights API key — used for mobile site scores.
# Free, rate-limited. https://developers.google.com/speed/docs/insights/v5/get-started
# May be the same project key as Places; PageSpeed also works keyless at low volume.
PAGESPEED_API_KEY=

# Companies House API key — free, for owner/director lookup.
# https://developer.company-information.service.gov.uk/
COMPANIES_HOUSE_API_KEY=

# Where cache and batch folders live (defaults shown).
PIPELINE_CACHE_DIR=.cache
PIPELINE_BATCHES_DIR=batches

# Cache time-to-live in days (spec: 30).
PIPELINE_CACHE_TTL_DAYS=30
